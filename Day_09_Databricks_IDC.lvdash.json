{
  "datasets": [
    {
      "name": "dataset1",
      "displayName": "events",
      "queryLines": [
        "SELECT * FROM ecommerce.bronze_table;"
      ],
      "catalog": "workspace",
      "schema": "ecommerce"
    }
  ],
  "pages": [
    {
      "name": "page1",
      "displayName": "Day_09_Databricks_IDC",
      "layout": [
        {
          "widget": {
            "name": "bar_chart1",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset1",
                  "fields": [
                    {
                      "name": "hourly(event_time)",
                      "expression": "DATE_TRUNC(\"HOUR\", `event_time`)"
                    },
                    {
                      "name": "event_type",
                      "expression": "`event_type`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "hourly(event_time)",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fieldName": "event_type",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "frame": {
                "title": "Event Time Distribution",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 3,
            "y": 0,
            "width": 3,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "text_box1",
            "multilineTextboxSpec": {
              "lines": [
                "\n",
                "# Dashboard for events table\n",
                "\n",
                "The dashboard you created for ecommerce_idc.bronze.events is ready!\n",
                "\n",
                "The widget to the right of this one allows you to generate a chart based on this dataset using natural language. Click the widget to start typing a description of the chart you'd like to see. Alternatively, you can edit any selected widget using the controls in the right panel.\n",
                "\n",
                "You can also edit, copy, or delete any widget on the canvas.\n",
                "    "
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 3,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "table1",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset1",
                  "fields": [
                    {
                      "name": "minutely(event_time)",
                      "expression": "DATE_TRUNC(\"MINUTE\", `event_time`)"
                    },
                    {
                      "name": "user_id",
                      "expression": "`user_id`"
                    },
                    {
                      "name": "product_id",
                      "expression": "`product_id`"
                    },
                    {
                      "name": "price",
                      "expression": "`price`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "minutely(event_time)",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "fields": [
                    {
                      "fieldName": "user_id"
                    },
                    {
                      "fieldName": "product_id"
                    },
                    {
                      "fieldName": "price"
                    }
                  ],
                  "scale": {
                    "type": "quantitative"
                  }
                }
              }
            }
          },
          "position": {
            "x": 0,
            "y": 4,
            "width": 6,
            "height": 6
          }
        }
      ],
      "pageType": "PAGE_TYPE_CANVAS"
    },
    {
      "name": "62fcd4c6",
      "displayName": "Global Filters",
      "layout": [
        {
